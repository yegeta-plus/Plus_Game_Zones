rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // ERP State collection security rules
    match /erp_state/{documentId} {
      allow read: if true;
      allow write: if request.resource.data.keys().hasAll(['state', 'updatedAt'])
                   && request.resource.data.updatedAt is string;
    }
    // Fallback rule for operational collections
    match /{document=**} {
      allow read, write: if true;
    }
  }
}
